{
  "name": "react-render-pulse-collector",
  "version": "1.0.1",
  "description": "Collector endpoint for react-render-pulse: validates batches and stores them in Postgres or JSON files.",
  "keywords": [
    "react",
    "performance",
    "rum",
    "real-user-monitoring",
    "collector",
    "postgres",
    "serverless"
  ],
  "author": "Amal M",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amalmktk/react-render-pulse.git",
    "directory": "packages/collector"
  },
  "bugs": {
    "url": "https://github.com/Amalmktk/react-render-pulse/issues"
  },
  "homepage": "https://github.com/Amalmktk/react-render-pulse#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./json-file": {
      "import": {
        "types": "./dist/jsonFile.d.ts",
        "default": "./dist/jsonFile.js"
      },
      "require": {
        "types": "./dist/jsonFile.d.cts",
        "default": "./dist/jsonFile.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ],
      "postgres": [
        "./dist/postgres.d.ts"
      ],
      "json-file": [
        "./dist/jsonFile.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "react-render-pulse": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
