{
  "name": "react-render-pulse-viewer",
  "version": "0.0.0",
  "description": "CLI and web viewer for react-render-pulse data: slowest components, worst devices, and trends.",
  "keywords": [
    "react",
    "performance",
    "rum",
    "real-user-monitoring",
    "dashboard",
    "cli"
  ],
  "author": "Amal M",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amalmktk/react-render-pulse.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/Amalmktk/react-render-pulse/issues"
  },
  "homepage": "https://github.com/Amalmktk/react-render-pulse#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "react-render-pulse-viewer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc -p tsconfig.build.json && node scripts/cjs-types.mjs && vite build web",
    "dev": "vite web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react-render-pulse": "workspace:^",
    "react-render-pulse-collector": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
