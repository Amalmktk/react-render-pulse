{
  "name": "react-render-pulse",
  "version": "1.0.3",
  "description": "Real-user render performance monitoring for React, at the component level.",
  "keywords": [
    "react",
    "hooks",
    "performance",
    "profiler",
    "render",
    "rum",
    "real-user-monitoring",
    "monitoring",
    "long-tasks",
    "opentelemetry",
    "observability"
  ],
  "author": "Amal M",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amalmktk/react-render-pulse.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/Amalmktk/react-render-pulse/issues"
  },
  "homepage": "https://github.com/Amalmktk/react-render-pulse#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "otel": [
        "./dist/otel.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "size-limit": [
    {
      "name": "full client (initRenderPulse + RenderMonitor + hook)",
      "path": "dist/index.js",
      "import": "{ initRenderPulse, RenderMonitor, useRenderMonitor }",
      "ignore": [
        "react"
      ],
      "limit": "3.75 kB"
    },
    {
      "name": "otel exporter",
      "path": "dist/otel.js",
      "import": "{ createOtelExporter }",
      "limit": "600 B"
    }
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^25.0.1",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
